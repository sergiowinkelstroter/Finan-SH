# Connection string *pooled* do Neon (Settings → Connection string → Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Segredo para assinar o JWT de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=

# Hash argon2id da senha compartilhada. Gere com: npm run hash-password -- "sua senha longa"
# IMPORTANTE: em arquivos .env* locais, escape todo '$' do hash como '\$' —
# o loader de env do Next.js expande "$nome" como variável e corrompe o
# hash silenciosamente. O script hash-password já imprime as duas versões
# (uma para colar na Vercel, outra escapada para uso local). Na Vercel o
# valor vai sem escape.
SHARED_PASSWORD_HASH=
